{
  "name": "felt-design-tokens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wireit",
    "compile": "wireit",
    "typecheck": "wireit",
    "export": "npm run compile && node bin/figma-variables-to-dtcg.js",
    "test": "npm run compile && node --test test/*.js"
  },
  "dependencies": {
    "style-dictionary": "^5.5.3"
  },
  "devDependencies": {
    "@figma/rest-api-spec": "^0.47.0",
    "@types/node": "^26.6.0",
    "typescript": "^7.0.2",
    "wireit": "^0.14.13",
    "yaml": "^2.9.1"
  },
  "wireit": {
    "typecheck": {
      "command": "tsc --noEmit",
      "files": [
        "pipeline/**/*.ts",
        "figma-api/**/*.ts",
        "bin/**/*.ts",
        "tsconfig.json"
      ],
      "output": []
    },
    "compile": {
      "command": "tsc",
      "files": [
        "pipeline/**/*.ts",
        "figma-api/**/*.ts",
        "bin/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "pipeline/**/*.js",
        "figma-api/**/*.js",
        "bin/**/*.js"
      ]
    },
    "generate": {
      "command": "node sd.config.js",
      "dependencies": [
        "compile"
      ],
      "files": [
        "tokens/figma/**/*.json",
        "tokens.config.yaml",
        "sd.config.js",
        "pipeline/**/*.ts"
      ],
      "output": [
        "dist/**"
      ]
    },
    "build": {
      "command": "node pipeline/report.js",
      "dependencies": [
        "typecheck",
        "generate"
      ],
      "output": []
    }
  }
}
